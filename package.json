{
  "name": "civifold",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "smoke:image": "tsx --env-file=.env.local scripts/smoke/image.ts",
    "smoke:spark": "tsx --env-file=.env.local scripts/smoke/spark.ts",
    "smoke:sam": "tsx --env-file=.env.local scripts/smoke/sam.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "analyze": "tsx --env-file=.env.local scripts/analyze-one.ts",
    "gen-dataset": "tsx --env-file=.env.local scripts/gen-dataset.ts",
    "gen-voices": "tsx scripts/gen-voices.ts",
    "smoke:intake": "tsx --env-file=.env.local scripts/smoke/intake.ts",
    "contact-sheet": "tsx scripts/contact-sheet.ts",
    "build-cases": "tsx scripts/build-cases.ts",
    "eval": "tsx --env-file=.env.local scripts/eval.ts",
    "summarize-eval": "tsx scripts/summarize-eval.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "push-cache": "tsx --env-file-if-exists=.env.local scripts/push-cache.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@meta-sam/parser": "^0.1.0",
    "@vercel/blob": "^2.8.2",
    "drizzle-orm": "^0.45.4",
    "exif-reader": "^2.0.3",
    "leaflet": "^1.9.4",
    "next": "^16.4.3",
    "openai": "^7.44.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  }
}
