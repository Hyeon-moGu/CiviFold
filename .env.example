# Meta Model API key (https://api.meta.ai). Leave it out of a public deployment to make live calls impossible.
MODEL_API_KEY=

# live | cached | cached_then_live. Unset: cached on Vercel, cached_then_live locally.
CIVIFOLD_MODE=

# Scripts only: another folder for recorded model calls, so a repeat evaluation run does not overwrite the first run's. Unset: .cache/llm
CIVIFOLD_CACHE_DIR=

# Set by the Vercel Marketplace integrations (Neon Postgres, Vercel Blob); `vercel env pull .env.local` copies them.
# Unset: local PGlite under .cache/pglite and photos under .cache/blobs.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Lets a visitor upload their own photo and run live model calls, up to LIVE_DAILY_USD per UTC day
# (left unset, a Vercel deployment allows no live spend at all, and a local server $2).
# Use a long random value (12+ characters): the code is the only thing between a visitor and the daily budget.
DEMO_ACCESS_CODE=
LIVE_DAILY_USD=2
